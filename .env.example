# Configuration for examples/notes (Lambda environment variables). Placeholders only:
# never put real credentials in a file in this repository. Tests and the local demo
# need none of these.

# OAuth 2.0 Protected Resource Metadata (RFC 9728)
MCP_RESOURCE=https://mcp.example.com/mcp
MCP_AUTHORIZATION_SERVERS=https://auth.example.com
MCP_SCOPES=notes:read notes:write

# JWT verification (RS256 / ES256 only)
MCP_JWT_ISSUER=https://auth.example.com
MCP_JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# MCP_JWT_AUDIENCE defaults to MCP_RESOURCE
# MCP_JWT_ALGORITHMS=RS256,ES256

# Notes example
NOTES_BUCKET=my-notes-bucket
# bearer (verify in the function) | authorizer (Lambda authorizer in front) | none (local only)
NOTES_AUTH=bearer
